{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "dist/main",
    "rootDir": "src/main",
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ]
    },
    "tsBuildInfoFile": "dist/main/.tsbuildinfo"
  },
  "include": [
    "src/main",
    "src/shared"
  ]
}
