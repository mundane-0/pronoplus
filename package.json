{
  "name": "pronoplus",
  "version": "1.0.0",
  "description": "ProNote+ - Application desktop complète remplaçant Pronote avec analyse avancée des notes et assistant IA",
  "main": "dist/main/index.js",
  "author": "ProNote+ Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/pronoplus.git"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:all": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:mac": "npm run build && electron-builder --mac",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.0",
    "framer-motion": "^13.5.0",
    "ics": "^3.6.0",
    "lucide-react": "^0.309.0",
    "moment": "^2.31.0",
    "pawnote": "^0.13.1",
    "pdfkit": "^0.14.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "sql.js": "^1.8.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^44.5.1",
    "electron-builder": "^24.9.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.pronoplus.app",
    "productName": "ProNote+",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Education"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    }
  },
  "keywords": [
    "pronote",
    "education",
    "grades",
    "electron",
    "desktop"
  ]
}
