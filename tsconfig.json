{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  // `src/main` est exclu ici parce que c'est un projet composite a part
  // entiere (`tsconfig.main.json`, reference ci-dessous). L'inclure aussi
  // ici fait echouer la compilation : TypeScript exige alors que les `.d.ts`
  // du projet reference soient a jour, ce qui echoue des que `dist/` est
  // vide — c'est-a-dire juste apres un nettoyage, autrement dit tres souvent.
  "include": ["src/renderer", "src/shared"],
  "references": [{ "path": "./tsconfig.main.json" }]
}
